# NEXUS Intelligence Platform — development environment
# Copy to .env before running docker compose.

# --- Application ---
APP_NAME=NEXUS
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string
APP_DEBUG=true
API_PREFIX=/api/v1

# --- Auth ---
JWT_SECRET=change-me-jwt-secret-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
REFRESH_EXPIRE_DAYS=14

# --- PostgreSQL (application / metadata) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus

# --- Redis (cache + job coordination) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=nexusminio
S3_SECRET_KEY=nexusminio
S3_BUCKET=nexus-raw
S3_REGION=us-east-1

# --- Search (Phase 3; optional in Phase 1) ---
OPENSEARCH_URL=http://opensearch:9200

# --- Frontend ---
NEXT_PUBLIC_API_BASE=/api/v1
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_APP_NAME=NEXUS
